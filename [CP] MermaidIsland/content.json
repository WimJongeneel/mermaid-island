{
  "$schema": "https://smapi.io/schemas/content-patcher.json",
  "Format": "2.4.0",
  "Changes": [
    {
      "Action": "EditData",
      "Target": "Data/Locations",
      "Entries": {
        "{{ModId}}_MermaidIsland": {
          "CreateOnLoad": {
            "MapPath": "Maps/{{ModId}}_MermaidIsland"
          }
        }
      }
    },
    {
      "Action": "Load",
      "Target": "Maps/{{ModId}}_MermaidIsland",
      "FromFile": "assets/mermaid-island.tmx"
    },
  ]
}