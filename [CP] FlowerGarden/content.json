  "Format": "2.4.0",
  "Changes": [
    {
      "Action": "EditData",
      "Target": "Data/Locations",
      "Entries": {
        "{{ModId}}_FlowerGarden": {
          "CreateOnLoad": {
            "MapPath": "Maps/{{ModId}}_FlowerGarden"
          }
        }
      }
